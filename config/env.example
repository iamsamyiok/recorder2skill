# Copy to your shell environment (PowerShell) before starting OpenCode.
# Never hardcode keys in files committed to a repository.

# Agnes AI (default model backend, see opencode.json provider "agnes").
# Read by OpenCode via the {env:AGNES_API_KEY} reference in opencode.json.
#   PowerShell:  $env:AGNES_API_KEY = "<your-key>"
#   bash/zsh:    export AGNES_API_KEY="<your-key>"
AGNES_API_KEY=your-agnes-key

# Alternative: OpenCode Zen API key (https://opencode.ai/zen) — switch the
# default model with /models after connecting.
#   PowerShell:  $env:OPENCODE_API_KEY = "<your-key>"
OPENCODE_API_KEY=your-opencode-zen-key

# Optional: override the demo data root.
# Defaults: C:\temp\recorder-demo (Windows), ~/.recorder-demo (Linux).
# Both the CLI and the plugin read this variable.
# RECORDER_DEMO_DATA_DIR=C:\temp\recorder-demo
